rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper to check if administrator
    function isAdmin() {
      return request.auth != null;
    }

    // Public readers can read images and sample PDFs. Only admins can upload/delete.
    match /{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
  }
}
